NODE_ENV=development
PORT=4000
CLIENT_ORIGIN=http://localhost:5173
MONGODB_URI=mongodb://127.0.0.1:27017/sheq_dev
JWT_SECRET=replace_with_a_long_random_secret_at_least_32_chars
JWT_EXPIRES_IN=1h
BCRYPT_ROUNDS=12

# Identity verification: keep disabled until provider is approved and integrated.
IDENTITY_PROVIDER=disabled
IDENTITY_VERIFICATION_ENABLED=false
IDENTITY_PROVIDER_BASE_URL=
IDENTITY_PROVIDER_API_KEY=

# Dataset import: set to an absolute path to a reviewed GeoJSON file if needed.
GEOJSON_IMPORT_PATH=
