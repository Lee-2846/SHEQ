NODE_ENV=development
PORT=4000
CLIENT_ORIGIN=http://localhost:5173
MONGODB_URI=mongodb://127.0.0.1:27017/sheq_dev
JWT_SECRET=replace_with_a_long_random_secret_at_least_32_chars
JWT_EXPIRES_IN=1h
BCRYPT_ROUNDS=12

# Identity verification: keep disabled until provider is approved and integrated.
IDENTITY_PROVIDER=disabled
IDENTITY_VERIFICATION_ENABLED=false
IDENTITY_PROVIDER_BASE_URL=
IDENTITY_PROVIDER_API_KEY=

# Dataset import: set to an absolute path to a reviewed GeoJSON file if needed.
GEOJSON_IMPORT_PATH=

# Email verification provider: keep disabled by default.
# Options: 'disabled' (default), 'mock_dev' (local development only), 'smtp', 'resend'
EMAIL_PROVIDER=disabled
EMAIL_FROM=SHEQ Safety <no-reply@sheq.app>
# SMTP configuration (if EMAIL_PROVIDER=smtp)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Resend configuration (if EMAIL_PROVIDER=resend)
RESEND_API_KEY=
# OTP settings
OTP_SECRET=replace_with_a_secure_random_salt_for_otp_hmac
OTP_EXPIRY_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60

