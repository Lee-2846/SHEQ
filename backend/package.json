{
  "name": "sheq-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "SHEQ API for community safety reports, identity-provider integration, admin moderation and hotspot candidates",
  "engines": { "node": ">=20" },
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "check": "node --check src/server.js && node --check src/app.js",
    "test": "node --test",
    "seed:admin": "node scripts/create-admin.js",
    "import:geojson": "node scripts/import-geojson.js",
    "pipeline:datasets": "python scripts/dataset_pipeline.py"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.9.5",
    "zod": "^3.24.1"
  }
}